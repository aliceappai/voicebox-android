<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is required to load the Voicebox web recorder. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- RECORD_AUDIO is required for the in-WebView voice recorder. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        MODIFY_AUDIO_SETTINGS is required for getUserMedia() inside the WebView.
        On Android 12+ Chromium routes mic capture through setCommunicationDevice(),
        which is hard-gated on this permission; without it the audio input stream is
        rejected with "Unable to select communication device!" and getUserMedia fails
        with NotReadableError. This is a normal permission — no runtime grant needed.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
        Location is required for the recorder's opt-in "Share precise location" toggle
        (navigator.geolocation inside the WebView). Requested at runtime only when the
        visitor turns the toggle on — see VoiceboxChromeClient.onGeolocationPermissionsShowPrompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application>
        <!--
            Lends the camera app the file a photo taken from the recorder's file input is
            saved to. Its own class and authority, so it merges alongside any FileProvider
            the host app declares. No CAMERA permission: the photo is taken by the camera app.
        -->
        <provider
            android:name="com.voicebox.voiceboxkit.VoiceboxFileProvider"
            android:authorities="${applicationId}.voiceboxkit.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/voiceboxkit_file_paths" />
        </provider>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is required to load the Voicebox web recorder. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- RECORD_AUDIO is required for the in-WebView voice recorder. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        MODIFY_AUDIO_SETTINGS is required for getUserMedia() inside the WebView.
        On Android 12+ Chromium routes mic capture through setCommunicationDevice(),
        which is hard-gated on this permission; without it the audio input stream is
        rejected with "Unable to select communication device!" and getUserMedia fails
        with NotReadableError. This is a normal permission — no runtime grant needed.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

</manifest>
